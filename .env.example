# Clean Kigali — environment configuration
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value here has a development default in src/config.ts, except
# SESSION_SECRET, which the server refuses to start without in production.

# 'production' hides error detail from users. Anything else shows it.
NODE_ENV=development

# HTTP
PORT=3000

# Database. Do not run as root in production: create a dedicated user with
# only SELECT, INSERT, UPDATE, DELETE on this schema.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=umuganda

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set once the site is served over HTTPS so the session cookie is marked
# Secure and HSTS is sent. Leave false for local http development.
TRUST_PROXY=false
FORCE_SECURE_COOKIE=false

# Gates the first-run admin setup page. Set this before deploying so nobody
# can reach /setup in the window between deploy and your first visit.
SETUP_TOKEN=
