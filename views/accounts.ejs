<%
/**
 * accounts.ejs — superadmin account management.
 *
 * Create a cell leader, and activate or deactivate an existing account.
 *
 * The sector dropdown depends on the district, which admin.js wires up from the
 * data attribute below rather than an inline script — the CSP forbids inline
 * script, and this keeps that promise. With JavaScript off the sector select
 * still lists every sector, and the server rejects a sector that does not
 * belong to the chosen district, so the pair can never be mismatched either way.
 */
%><!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/staffhead', { pageTitle: 'Accounts' }) %>
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body class="staff">
  <a class="skip-link" href="#main">Skip to main content</a>
  <%- include('partials/adminnav', { active: 'accounts' }) %>

  <main id="main" class="workspace">
    <header class="work-head">
      <div>
        <h1>Accounts</h1>
        <p>A leader sees only the reports filed in their cell. You keep the full queue.</p>
      </div>
    </header>

    <% if (error) { %>
      <div class="flash flash-error" role="alert"><span><%= error %></span></div>
    <% } %>
    <% if (notice) { %>
      <div class="flash flash-success" role="status"><span><%= notice %></span></div>
    <% } %>

    <!-- Create a leader -->
    <section class="panel-card" aria-labelledby="create-heading">
      <h2 id="create-heading" class="card-title">Add a cell leader</h2>

      <form method="POST" action="/admin/accounts" autocomplete="off" data-leader-form>
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

        <div class="field-row">
          <div class="field">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" required maxlength="50"
                   autocapitalize="none" autocorrect="off" spellcheck="false"
                   aria-describedby="username-hint">
            <p class="field-hint" id="username-hint">3–50 characters: letters, numbers, dot, underscore or hyphen.</p>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required maxlength="200"
                   autocomplete="new-password" aria-describedby="password-hint">
            <p class="field-hint" id="password-hint">At least 12 characters, with letters and numbers.</p>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="district">District</label>
            <select id="district" name="district" required data-district-select>
              <option value="">Choose a district…</option>
              <% districts.forEach(function (d) { %>
                <option value="<%= d.name %>"><%= d.name %></option>
              <% }); %>
            </select>
          </div>

          <div class="field">
            <label for="sector">Sector</label>
            <select id="sector" name="sector" required data-sector-select>
              <option value="">Choose a sector…</option>
              <% districts.forEach(function (d) { %>
                <% d.sectors.forEach(function (sec) { %>
                  <option value="<%= sec %>" data-district="<%= d.name %>"><%= sec %></option>
                <% }); %>
              <% }); %>
            </select>
          </div>

          <div class="field">
            <label for="cell">Cell</label>
            <input type="text" id="cell" name="cell" required maxlength="50"
                   aria-describedby="cell-hint" placeholder="Rukiri I">
            <p class="field-hint" id="cell-hint">
              Type it exactly as residents will see it — this is what routes reports to this leader.
            </p>
          </div>
        </div>

        <button type="submit" class="btn btn-primary form-action">Create leader account</button>
      </form>
    </section>

    <!-- Existing accounts -->
    <section aria-labelledby="accounts-heading">
      <div class="queue-head">
        <h2 id="accounts-heading">Existing accounts</h2>
        <p class="queue-count"><%= accounts.length %> total</p>
      </div>

      <ul class="account-list">
        <% accounts.forEach(function (a) { %>
          <li class="account-row<%= a.isActive ? '' : ' is-inactive' %>">
            <div class="account-who">
              <span class="avatar" aria-hidden="true"><%= String(a.username).charAt(0).toUpperCase() %></span>
              <div>
                <h3 class="row-title"><%= a.username %></h3>
                <p class="row-meta"><%= a.role === 'superadmin' ? 'Superadmin' : 'Cell leader' %><%= a.id === adminId ? ' · you' : '' %></p>
              </div>
            </div>

            <div>
              <% if (a.role === 'superadmin') { %>
                <p class="row-strong">All of Kigali</p>
                <p class="row-meta">Not scoped</p>
              <% } else { %>
                <p class="row-strong"><%= a.cell || 'No cell set' %></p>
                <p class="row-meta"><%= a.sector || '—' %><%= a.district ? ', ' + a.district : '' %></p>
              <% } %>
            </div>

            <div>
              <p class="row-strong"><%= a.lastLogin ? a.lastLogin.toISOString().slice(0, 16).replace('T', ' ') : 'Never signed in' %></p>
              <p class="row-meta">Added <%= a.createdAt.toISOString().slice(0, 10) %></p>
            </div>

            <div class="account-flags">
              <span class="chip <%= a.isActive ? 'chip-done' : 'chip-notdone' %>"><%= a.isActive ? 'Active' : 'Deactivated' %></span>
              <% if (a.isLocked) { %><span class="chip chip-high">Locked out</span><% } %>
            </div>

            <div class="account-action">
              <% if (a.id !== adminId) { %>
                <form method="POST" action="/admin/accounts/active">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                  <input type="hidden" name="id" value="<%= a.id %>">
                  <input type="hidden" name="active" value="<%= a.isActive ? '0' : '1' %>">
                  <button type="submit" class="btn <%= a.isActive ? 'btn-outline' : 'btn-primary' %> btn-small">
                    <%= a.isActive ? 'Deactivate' : 'Reactivate' %>
                  </button>
                </form>
              <% } %>
            </div>
          </li>
        <% }); %>
      </ul>
    </section>

  </main>

  <script src="/js/admin.js"></script>
</body>
</html>
