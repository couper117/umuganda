<%
/**
 * feed.ejs — the full public feed.
 *
 * Every card is rendered server-side; the search box filters what is already
 * on the page rather than querying, so there is no endpoint here to rate-limit
 * and no way to enumerate anything that was not already public.
 */
%><!DOCTYPE html>
<html lang="<%= t.htmlLang %>">
<head>
  <%- include('partials/head', { meta: meta }) %>
</head>
<body data-strings="<%= clientStrings %>">
  <a class="skip-link" href="#main"><%= t.skipLink %></a>

  <%- include('partials/navbar', { t: t, locale: locale, languages: languages, current: current }) %>

  <main id="main">

    <section class="page-head">
      <div class="container">
        <h1><%= t.feed.heading %></h1>
        <p><%= t.home.recentIntro %></p>
      </div>
    </section>

    <section class="section">
      <div class="container">

        <% if (reports.length === 0) { %>

          <div class="empty-state">
            <%- include('partials/icons', { name: 'inbox' }) %>
            <p><%= t.feed.empty %></p>
            <p style="margin-top:22px;">
              <a class="btn btn-primary" href="/<%= locale %>/report">
                <%- include('partials/icons', { name: 'pencil' }) %><%= t.nav.report %>
              </a>
            </p>
          </div>

        <% } else { %>

          <div class="feed-toolbar">
            <div class="field">
              <label for="feed-search"><%= t.feed.searchLabel %></label>
              <input type="text" id="feed-search" data-feed-search autocomplete="off"
                     placeholder="<%= t.feed.searchPlaceholder %>">
            </div>
          </div>

          <div class="feed-grid" data-feed-grid>
            <% reports.forEach(function (r) { %>
              <%- include('partials/feedcard', { t: t, r: r }) %>
            <% }); %>
          </div>

          <p class="empty-state" data-feed-empty hidden><%= t.feed.noMatches %></p>
          <p class="visually-hidden" role="status" data-feed-status></p>

        <% } %>

      </div>
    </section>

  </main>

  <%- include('partials/sitefooter', { t: t, locale: locale, year: year }) %>
</body>
</html>
