<%
/**
 * forbidden.ejs — shown when a signed-in account reaches a page its role does
 * not allow.
 *
 * Deliberately not a redirect to sign-in: the visitor is already identified, so
 * bouncing them to a login form would send them round a loop that can never
 * succeed. This says what happened.
 */
%><!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/staffhead', { pageTitle: 'Not allowed' }) %>
</head>
<body class="auth">
  <%- include('partials/authart') %>
  <main class="auth-main">
    <div class="auth-panel">
      <a class="brand auth-brand" href="/admin"><%- include('partials/logo') %><span>Clean Kigali</span></a>
      <h1>Not allowed</h1>
      <p class="auth-lead"><%= message %></p>
      <a href="/admin" class="btn btn-primary btn-block auth-submit">Back to the queue</a>
    </div>
  </main>
</body>
</html>
