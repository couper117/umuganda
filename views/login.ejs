<%
/**
 * login.ejs — staff sign-in.
 *
 * The error message is deliberately identical for a wrong password and an
 * unknown username; see services/admins.ts.
 */
%><!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/staffhead', { pageTitle: 'Sign in' }) %>
</head>
<body class="auth">
  <%- include('partials/authart') %>
  <main class="auth-main">
    <div class="auth-panel">
      <a class="brand auth-brand" href="<%= portalHref %>"><%- include('partials/logo') %><span>Clean Kigali</span></a>
      <h1>Welcome back</h1>
      <p class="auth-lead">Sign in to the dashboard for authorised staff of the Clean Kigali Initiative.</p>

      <% if (error) { %>
        <div class="flash flash-error" role="alert"><span><%= error %></span></div>
      <% } %>

      <form method="POST" action="/login" autocomplete="on">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">

        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required maxlength="50" autocomplete="username"
                 autocapitalize="none" autocorrect="off" spellcheck="false" autofocus>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required maxlength="200" autocomplete="current-password">
        </div>

        <button type="submit" class="btn btn-primary btn-block auth-submit">Sign in</button>
      </form>

      <p class="auth-foot"><a href="<%= portalHref %>">Back to the public site</a></p>
    </div>
  </main>
</body>
</html>
