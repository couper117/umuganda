<%
/**
 * icons.ejs — inline SVG icon set.
 *
 * The reference project pulls Font Awesome from a CDN. This app's CSP is
 * `script-src 'self'`, and the Font Awesome kit is a script tag, so adopting it
 * would mean opening the policy up. These are drawn inline instead: no network
 * request, no CSP change, and they inherit currentColor so a single rule
 * recolours them.
 *
 * Include it with a `name`, or with a `category` / `urgency` value to have the
 * right drawing picked from the maps below.
 *
 * `name` is looked up against the map below; an unknown name renders the dot,
 * so a typo degrades to a neutral mark rather than throwing mid-page.
 */

const ICONS = {
  // Navigation
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  pencil: '<path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4Z"/><path d="m14.5 6.5 3 3"/>',
  list: '<path d="M8 6h13M8 12h13M8 18h13"/><path d="M3.5 6h.01M3.5 12h.01M3.5 18h.01"/>',
  lock: '<rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',

  // Report categories
  bin: '<path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M6 7v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7"/><path d="M10 12v5M14 12v5"/>',
  drain: '<path d="M3 8h18"/><path d="M4 8v9a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8"/><path d="M8 12v5M12 12v5M16 12v5"/>',
  dumping: '<path d="M3 18h4l2-9h8l2 5h2"/><circle cx="8" cy="19.5" r="1.6"/><circle cx="17" cy="19.5" r="1.6"/><path d="M11 3v4M9 5h4"/>',
  litter: '<path d="M12 3v3M7.5 5.5 9 8M16.5 5.5 15 8"/><path d="M5 11h14l-1.5 9h-11L5 11Z"/>',
  other: '<circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><path d="M12 16.5h.01"/>',

  // Urgency
  leaf: '<path d="M5 19c0-8 6-13 14-13 0 9-5 14-14 13Z"/><path d="M5 19c3-4 6-6 9-7"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.5l3.5 2"/>',
  alert: '<path d="M12 4 2.5 20h19L12 4Z"/><path d="M12 10v4"/><path d="M12 17.5h.01"/>',

  // Status / feedback
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  cross: '<path d="M6 6l12 12M18 6 6 18"/>',
  clip: '<rect x="7" y="4" width="10" height="16" rx="2"/><path d="M10 4h4"/><path d="M10 10h4M10 14h4"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/>',
  pin: '<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/>',
  inbox: '<path d="M4 13h4l1.5 3h5L16 13h4"/><path d="M5 5h14l1 8v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-4l1-8Z"/>',
};

/** Category and urgency values map onto the drawings above. */
const BY_CATEGORY = {
  'full-bin': 'bin',
  'blocked-drain': 'drain',
  'illegal-dumping': 'dumping',
  litter: 'litter',
  other: 'other',
};

const BY_URGENCY = { low: 'leaf', medium: 'clock', high: 'alert' };

/* Read through `locals` rather than as bare identifiers: only one of name /
   category / urgency is ever passed, and an undeclared local is a
   ReferenceError in a compiled EJS template, not undefined. */
let key = locals.name;
if (locals.category) key = BY_CATEGORY[locals.category] || 'other';
if (locals.urgency) key = BY_URGENCY[locals.urgency] || 'leaf';

const body = ICONS[key] || ICONS.other;
%><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%- body %></svg>
