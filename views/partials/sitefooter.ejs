<%
/**
 * sitefooter.ejs — shared by every public page, and where the scripts load.
 */
%>
<footer class="site-footer">
  <div class="imigongo-band" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/<%= locale %>">
          <%- include('logo') %>
          <span>Clean Kigali</span>
        </a>
        <p class="footer-desc"><%= t.footer.description %></p>
        <p class="footer-desc"><%= t.footer.operatorLine %></p>
      </div>

      <div>
        <h2 class="footer-title"><%= t.footer.resourcesHeading %></h2>
        <ul class="footer-links">
          <li><a href="/<%= locale %>/report"><%= t.nav.report %></a></li>
          <li><a href="/<%= locale %>/track"><%= t.nav.track %></a></li>
          <li><a href="/<%= locale %>/reports"><%= t.nav.reports %></a></li>
          <li><a href="/login"><%= t.footer.adminLink %></a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer-title"><%= t.footer.partnersHeading %></h2>
        <ul class="footer-links">
          <li><a href="https://www.kigalicity.gov.rw/" target="_blank" rel="noopener noreferrer"><%= t.footer.cityLink %></a></li>
          <li><a href="https://www.rema.gov.rw/" target="_blank" rel="noopener noreferrer"><%= t.footer.remaLink %></a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p><%= t.footer.dataNote %></p>
      <p>&copy; <%= year %> Clean Kigali Initiative</p>
    </div>
  </div>
</footer>

<script src="/js/app.js" defer></script>
