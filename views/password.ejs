<%
/**
 * password.ejs — change your own password.
 *
 * Two states: the form, or a confirmation once the change has gone through.
 *
 * The fields are real password inputs with autocomplete hints, so a password
 * manager recognises this as a change-password form and offers to store the
 * new value.
 */
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Change password — Clean Kigali</title>
  <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body class="admin-body">
  <a class="skip-link" href="#main">Skip to main content</a>

  <nav class="navbar" aria-label="Dashboard navigation">
    <div class="container nav-inner">
      <a class="navbar-brand" href="/admin">
        <span class="brand-mark" aria-hidden="true">CK</span>
        <span>Clean<span class="brand-highlight">Kigali</span></span>
      </a>

      <span class="admin-tag">Account</span>

      <div class="admin-identity">
        <a class="nav-link" href="/admin">Back to the queue</a>
        <span class="admin-user">Signed in as <strong><%= admin %></strong></span>
        <form method="POST" action="/logout" class="logout-form">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <button type="submit" class="btn-cta btn-cta-quiet">Sign out</button>
        </form>
      </div>
    </div>
  </nav>

  <main id="main" class="auth-page">
    <div class="auth-panel">

      <% if (changed) { %>

        <span class="icon-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 12.5 4.5 4.5L19 7.5"/>
          </svg>
        </span>

        <div class="auth-head">
          <h1>Password changed</h1>
          <p>Your new password is active from now on.</p>
        </div>

        <div class="flash flash-success" role="status">
          <span>
            Anyone signed in as <strong><%= admin %></strong> on another browser or device has been
            signed out. Only this window is still active.
          </span>
        </div>

        <a href="/admin" class="btn btn-primary btn-block">Back to the queue</a>

      <% } else { %>

        <span class="icon-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
          </svg>
        </span>

        <div class="auth-head">
          <h1>Change password</h1>
          <p>You are changing the password for <strong><%= admin %></strong>.</p>
        </div>

        <% if (error) { %>
          <div class="flash flash-error" role="alert"><span><%= error %></span></div>
        <% } %>

        <form method="POST" action="/admin/password" autocomplete="on">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <!-- Names the account for a password manager, without offering an
               editable username field this form has no business changing. -->
          <input type="text" name="username" value="<%= admin %>" autocomplete="username"
                 hidden aria-hidden="true" tabindex="-1" readonly>

          <div class="field">
            <label class="field-label" for="current_password">Current password</label>
            <input type="password" id="current_password" name="current_password" class="field-input"
                   required maxlength="200" autocomplete="current-password" autofocus>
          </div>

          <div class="field">
            <label class="field-label" for="new_password">New password</label>
            <input type="password" id="new_password" name="new_password" class="field-input"
                   required maxlength="200" aria-describedby="new-password-hint"
                   autocomplete="new-password">
            <p class="password-rules" id="new-password-hint">
              At least 12 characters, including letters and numbers.
            </p>
          </div>

          <div class="field">
            <label class="field-label" for="confirm_password">Confirm new password</label>
            <input type="password" id="confirm_password" name="confirm_password" class="field-input"
                   required maxlength="200" autocomplete="new-password">
          </div>

          <div class="flash flash-info">
            <span>Changing your password signs you out everywhere else. This window stays open.</span>
          </div>

          <button type="submit" class="btn btn-primary btn-block">Change password</button>
        </form>

      <% } %>

      <p class="auth-foot">
        <a href="/admin">Back to the queue</a>
      </p>
    </div>
  </main>
</body>
</html>
