<%
/**
 * password.ejs — change your own password.
 *
 * Two states: the form, or a confirmation once the change has gone through.
 *
 * The fields are real password inputs with autocomplete hints, so a password
 * manager recognises this as a change-password form and offers to store the
 * new value.
 */
%><!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/staffhead', { pageTitle: 'Change password' }) %>
</head>
<body class="staff">
  <a class="skip-link" href="#main">Skip to main content</a>
  <%- include('partials/adminnav', { active: 'password' }) %>

  <main id="main" class="workspace">
    <div class="panel form-panel">

      <% if (changed) { %>

        <h1 class="form-title">Password changed</h1>
        <p class="auth-lead">Your new password is active from now on.</p>

        <div class="flash flash-success" role="status">
          <span>
            Anyone signed in as <strong><%= admin %></strong> on another browser or device has been
            signed out. Only this window is still active.
          </span>
        </div>

        <a href="/admin" class="btn btn-primary btn-block auth-submit">Back to the queue</a>

      <% } else { %>

        <h1 class="form-title">Change password</h1>
        <p class="auth-lead">You are changing the password for <strong><%= admin %></strong>.</p>

        <% if (error) { %>
          <div class="flash flash-error" role="alert"><span><%= error %></span></div>
        <% } %>

        <form method="POST" action="/admin/password" autocomplete="on">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <!-- Names the account for a password manager, without offering an
               editable username field this form has no business changing. -->
          <input type="text" name="username" value="<%= admin %>" autocomplete="username"
                 hidden aria-hidden="true" tabindex="-1" readonly>

          <div class="field">
            <label for="current_password">Current password</label>
            <input type="password" id="current_password" name="current_password" 
                   required maxlength="200" autocomplete="current-password" autofocus>
          </div>

          <div class="field">
            <label for="new_password">New password</label>
            <input type="password" id="new_password" name="new_password" 
                   required maxlength="200" aria-describedby="new-password-hint"
                   autocomplete="new-password">
            <p class="field-hint" id="new-password-hint">
              At least 12 characters, including letters and numbers.
            </p>
          </div>

          <div class="field">
            <label for="confirm_password">Confirm new password</label>
            <input type="password" id="confirm_password" name="confirm_password" 
                   required maxlength="200" autocomplete="new-password">
          </div>

          <div class="flash flash-info form-note">
            <span>Changing your password signs you out everywhere else. This window stays open.</span>
          </div>

          <button type="submit" class="btn btn-primary btn-block auth-submit">Change password</button>
        </form>

      <% } %>
    </div>
  </main>
</body>
</html>
