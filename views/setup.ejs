<%
/**
 * setup.ejs — first-run creation of the one admin account.
 *
 * Three states: locked (an account already exists, or the token is wrong),
 * created (done — go and sign in), and the form itself.
 */
%><!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/staffhead', { pageTitle: 'Setup' }) %>
</head>
<body class="auth">
  <%- include('partials/authart') %>
  <main class="auth-main">
    <div class="auth-panel">
      <a class="brand auth-brand" href="<%= portalHref %>"><%- include('partials/logo') %><span>Clean Kigali</span></a>

      <% if (lockedReason) { %>

        <h1>Setup unavailable</h1>
        <p class="auth-lead"><%= lockedReason %></p>
        <a href="/login" class="btn btn-primary btn-block auth-submit">Go to sign in</a>

      <% } else if (created) { %>

        <h1>Account created</h1>

        <div class="flash flash-success" role="status">
          <span>Your administrator account is ready. You can sign in to the dashboard now.</span>
        </div>
        <div class="flash flash-info">
          <span>
            <strong>Before going live:</strong> set <code>SETUP_TOKEN</code> in your environment, or remove this
            route. It has disabled itself now that an account exists, but closing it off entirely is one less
            thing to reason about.
          </span>
        </div>
        <a href="/login" class="btn btn-primary btn-block auth-submit">Go to sign in</a>

      <% } else { %>

        <h1>First-time setup</h1>
        <p class="auth-lead">No administrator account exists yet. Create one to secure the dashboard.</p>

        <% if (error) { %>
          <div class="flash flash-error" role="alert"><span><%= error %></span></div>
        <% } %>

        <form method="POST" action="/setup" autocomplete="off">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <% if (tokenRequired) { %>
            <input type="hidden" name="token" value="<%= token %>">
          <% } %>

          <div class="field">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" 
                   required maxlength="50" aria-describedby="username-hint"
                   autocapitalize="none" autocorrect="off" spellcheck="false" autofocus>
            <p class="field-hint" id="username-hint">3–50 characters: letters, numbers, dot, underscore or hyphen.</p>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" 
                   required maxlength="200" aria-describedby="password-hint"
                   autocomplete="new-password">
            <p class="field-hint" id="password-hint">At least 12 characters, including letters and numbers.</p>
          </div>

          <div class="field">
            <label for="confirm_password">Confirm password</label>
            <input type="password" id="confirm_password" name="confirm_password" 
                   required maxlength="200" autocomplete="new-password">
          </div>

          <button type="submit" class="btn btn-primary btn-block auth-submit">Create administrator account</button>
        </form>

      <% } %>

      <p class="auth-foot">
        <a href="<%= portalHref %>">Back to the public site</a>
      </p>
    </div>
  </main>
</body>
</html>
