<%
/**
 * track.ejs — the reference lookup, on its own page.
 *
 * The form submits through fetch to /:locale/track/lookup and the result is
 * built in the browser. src/client/app.ts constructs it with createElement and
 * textContent rather than an innerHTML template, so report content cannot
 * become markup.
 *
 * `prefill` lets the success page link straight here with the box filled in.
 */
%><!DOCTYPE html>
<html lang="<%= t.htmlLang %>">
<head>
  <%- include('partials/head', { meta: meta }) %>
</head>
<body data-strings="<%= clientStrings %>">
  <a class="skip-link" href="#main"><%= t.skipLink %></a>

  <%- include('partials/navbar', { t: t, locale: locale, languages: languages, current: current }) %>

  <main id="main">

    <section class="page-head">
      <div class="container">
        <h1><%= t.tracker.heading %></h1>
        <p><%= t.tracker.intro %></p>
      </div>
    </section>

    <section class="section section-panel">
      <div class="container">
        <div class="panel panel-narrow">

          <form class="tracker-form" data-track-form data-endpoint="/<%= locale %>/track/lookup" novalidate>
            <div class="field">
              <label for="reference"><%= t.tracker.inputLabel %></label>
              <span class="field-hint" id="reference-hint"><%= t.tracker.inputHint %></span>
              <input type="text" id="reference" name="reference" maxlength="20" autocomplete="off"
                     aria-describedby="reference-hint"
                     placeholder="<%= t.tracker.placeholder %>"
                     value="<%= prefill %>">
            </div>
            <button class="btn btn-primary" type="submit" data-submit
                    data-label-submitting="<%= t.tracker.working %>">
              <%- include('partials/icons', { name: 'search' }) %><%= t.tracker.submit %>
            </button>
          </form>

          <!-- Results land here. The live region means a screen reader is told
               the outcome without the page moving, which is what replaced the
               alert() dialogs the PHP version used. -->
          <div class="track-result" data-track-result role="status" aria-live="polite"
               aria-label="<%= t.tracker.resultsLabel %>"></div>

        </div>
      </div>
    </section>

  </main>

  <%- include('partials/sitefooter', { t: t, locale: locale, year: year }) %>
</body>
</html>
